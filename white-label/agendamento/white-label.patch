diff --git a/assets/js/pages/booking.js b/assets/js/pages/booking.js
index 7b616bd..2369acc 100644
--- a/assets/js/pages/booking.js
+++ b/assets/js/pages/booking.js
@@ -681,6 +681,18 @@ App.Pages.Booking = (function () {
         return true;
     }
 
+    /**
+     * Format a service price, e.g. "R$ 80,00" (BRL / R$) or "80.00 USD".
+     */
+    function formatPrice(service) {
+        const price = Number(service.price);
+        const currency = String(service.currency || '').trim();
+        if (currency === 'R$' || currency.toUpperCase() === 'BRL') {
+            return price.toLocaleString('pt-BR', {style: 'currency', currency: 'BRL'});
+        }
+        return `${price.toFixed(2)} ${currency}`;
+    }
+
     /**
      * Every time this function is executed, it updates the confirmation page with the latest
      * customer settings and input for the appointment booking.
@@ -750,7 +762,7 @@ App.Pages.Booking = (function () {
                 </div> 
                 <div class="mb-2" ${!Number(service.price) ? 'hidden' : ''}>
                     <i class="fas fa-cash-register me-2"></i>
-                    ${Number(service.price).toFixed(2)} ${service.currency}
+                    ${formatPrice(service)}
                 </div>
             </div>     
         `);
@@ -963,7 +975,7 @@ App.Pages.Booking = (function () {
         }
 
         if (Number(service.price) > 0) {
-            additionalInfoParts.push(`${lang('price')}: ${Number(service.price).toFixed(2)} ${service.currency}`);
+            additionalInfoParts.push(`${lang('price')}: ${formatPrice(service)}`);
         }
 
         if (service.location) {
