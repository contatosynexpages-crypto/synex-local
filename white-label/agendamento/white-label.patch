+/* White label (Synex Local) — painel. Cor principal vem de "company_color". */
+@font-face { font-family: 'WL Text'; font-weight: 400; src: url('../fonts/white-label/manrope-latin-400-normal.woff2') format('woff2'); }
+@font-face { font-family: 'WL Text'; font-weight: 600; src: url('../fonts/white-label/manrope-latin-600-normal.woff2') format('woff2'); }
+@font-face { font-family: 'WL Text'; font-weight: 700; src: url('../fonts/white-label/manrope-latin-700-normal.woff2') format('woff2'); }
+body { font-family: 'WL Text', system-ui, sans-serif; }
+/* Texto legível sobre as cores dos serviços */
+.fc-event, .fc-event .fc-event-main, .fc-event .fc-event-time, .fc-event .fc-event-title { color: #fff !important; }
+#header-logo h6 { letter-spacing: .02em; }
+
+/* Tela de login: botões e títulos na cor da marca */
+.btn-primary { background: var(--bs-primary) !important; border-color: var(--bs-primary) !important; background-image: none !important; }
+.text-primary { color: var(--bs-primary) !important; }
diff --git a/assets/css/white-label.scss b/assets/css/white-label.scss
new file mode 100644
index 0000000..3387287
--- /dev/null
+++ b/assets/css/white-label.scss
@@ -0,0 +1,131 @@
+/* ----------------------------------------------------------------------------
+ * White label (Synex Local) — camada visual sobre o Easy!Appointments (GPLv3).
+ * A cor principal vem de "company_color" (Configurações > Geral); aqui ficam
+ * tipografia, fundo e acabamento. Para outro cliente, troque só as variáveis.
+ * ---------------------------------------------------------------------------- */
+
+@font-face { font-family: 'WL Display'; font-weight: 400; font-display: swap;
+    src: url('../fonts/white-label/dm-serif-display-latin-400-normal.woff2') format('woff2'); }
+@font-face { font-family: 'WL Text'; font-weight: 400; font-display: swap;
+    src: url('../fonts/white-label/manrope-latin-400-normal.woff2') format('woff2'); }
+@font-face { font-family: 'WL Text'; font-weight: 600; font-display: swap;
+    src: url('../fonts/white-label/manrope-latin-600-normal.woff2') format('woff2'); }
+@font-face { font-family: 'WL Text'; font-weight: 700; font-display: swap;
+    src: url('../fonts/white-label/manrope-latin-700-normal.woff2') format('woff2'); }
+
+:root {
+    --wl-bg: #F6EEEA;          /* fundo da página (blush) */
+    --wl-surface: #FFFDFB;     /* cartão do agendamento */
+    --wl-accent: #C9A46A;      /* detalhe dourado */
+    --wl-ink: #2E2128;         /* texto */
+    --wl-muted: #7D6870;
+    --wl-radius: 18px;
+}
+
+body {
+    background: var(--wl-bg) !important;
+    color: var(--wl-ink);
+    font-family: 'WL Text', system-ui, sans-serif;
+}
+
+#book-appointment-wizard {
+    background: var(--wl-surface) !important;
+}
+@media (min-width: 768px) {
+    #book-appointment-wizard {
+        border-radius: var(--wl-radius) !important;
+        box-shadow: 0 24px 60px -30px rgba(46, 33, 40, .35) !important;
+    }
+}
+
+/* Cabeçalho */
+#header {
+    background:
+        radial-gradient(120% 140% at 100% 0%, rgba(201, 164, 106, .28), transparent 55%),
+        var(--bs-primary) !important;
+}
+#company-name > span {
+    font-family: 'WL Display', Georgia, serif;
+    font-size: 2rem;
+    letter-spacing: .01em;
+}
+#company-logo { border-radius: 50%; box-shadow: 0 0 0 3px rgba(255, 255, 255, .15); }
+.display-booking-selection { letter-spacing: .02em; }
+#book-appointment-wizard .book-step.active-step { border-radius: 14px !important; }
+#book-appointment-wizard .book-step:not(.active-step) { border-radius: 12px !important; }
+
+/* Títulos dos passos */
+.frame-title, #book-appointment-wizard h2, #book-appointment-wizard .h2 {
+    font-family: 'WL Display', Georgia, serif;
+    color: var(--wl-ink);
+    font-weight: 400;
+}
+
+/* Campos */
+#book-appointment-wizard .form-control,
+#book-appointment-wizard .form-select {
+    border-radius: 12px;
+    border-color: #E6D8D2;
+    padding-top: .7rem; padding-bottom: .7rem;
+}
+#book-appointment-wizard .form-control:focus,
+#book-appointment-wizard .form-select:focus {
+    border-color: var(--bs-primary);
+    box-shadow: 0 0 0 .2rem rgba(var(--bs-primary-rgb), .15);
+}
+#book-appointment-wizard label { font-weight: 600; color: var(--wl-ink); }
+#service-description { color: var(--wl-muted); }
+
+/* Botões: cor da marca em vez do preto padrão */
+#book-appointment-wizard .button-next,
+#book-appointment-wizard #book-appointment-submit {
+    background: var(--bs-primary) !important;
+    border-color: var(--bs-primary) !important;
+    color: #fff !important;
+    border-radius: 999px;
+    padding: .7rem 1.6rem;
+    font-weight: 600;
+}
+#book-appointment-wizard .button-back {
+    border-radius: 999px;
+    padding: .7rem 1.4rem;
+    color: var(--wl-ink);
+}
+
+/* Horários */
+#book-appointment-wizard #available-hours .available-hour {
+    border-radius: 999px;
+    border-color: #E6D8D2;
+    color: var(--wl-ink);
+}
+#book-appointment-wizard #available-hours .available-hour:hover { border-color: var(--bs-primary); }
+
+/* Calendário */
+#book-appointment-wizard .flatpickr-day.selected,
+#book-appointment-wizard .flatpickr-day.selected:hover {
+    background: var(--bs-primary) !important;
+    border-color: var(--bs-primary) !important;
+}
+#book-appointment-wizard .flatpickr-months .flatpickr-month,
+#book-appointment-wizard .flatpickr-weekdays,
+#book-appointment-wizard span.flatpickr-weekday,
+#book-appointment-wizard .flatpickr-current-month .flatpickr-monthDropdown-months {
+    background: var(--bs-primary) !important;
+}
+
+/* Rodapé */
+#frame-footer { color: var(--wl-muted); border-color: #EFE3DE !important; }
+#frame-footer a { color: var(--bs-primary); font-weight: 600; text-decoration: none; }
+
+/* Simplificações para o público local */
+#select-language { display: none !important; }
+#select-timezone, label[for="select-timezone"] { display: none !important; }
+
+/* Página de confirmação (message layout) */
+#message-frame .btn-primary, #message-frame .btn-success, .message-layout .btn-primary {
+    background: var(--bs-primary) !important; border-color: var(--bs-primary) !important; border-radius: 999px;
+}
+#message-frame h3, #message-frame .text-success { color: var(--bs-primary) !important; font-family: 'WL Display', Georgia, serif; font-weight: 400; }
+
+/* Fuso horário não é útil para atendimento local */
+#appointment-details div:has(> .fa-globe) { display: none !important; }
