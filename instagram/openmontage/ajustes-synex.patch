new file mode 100644
index 0000000..8bff45f
--- /dev/null
+++ b/remotion-composer/src/fonts/local.ts
@@ -0,0 +1,27 @@
+// Local font loader with the same call shape as @remotion/google-fonts loadFont.
+// Serves the fonts from public/fonts via @font-face (for environments where
+// Google Fonts is unreachable). Declared once, at bundle load.
+import { staticFile } from "remotion";
+
+const FONTS: [string, string, string[]][] = [
+  ["Space Grotesk", "space-grotesk", ["300", "400", "500", "600", "700"]],
+  ["Playfair Display", "playfair-display", ["400", "500", "600", "700", "800", "900"]],
+];
+
+if (typeof document !== "undefined" && !document.getElementById("local-fonts")) {
+  const css = FONTS.flatMap(([family, slug, weights]) =>
+    weights.map(
+      (w) =>
+        `@font-face{font-family:'${family}';font-weight:${w};font-style:normal;font-display:block;` +
+        `src:url('${staticFile(`fonts/${slug}-latin-${w}-normal.woff2`)}') format('woff2');}`,
+    ),
+  ).join("\n");
+  const el = document.createElement("style");
+  el.id = "local-fonts";
+  el.textContent = css;
+  document.head.appendChild(el);
+}
+
+const make = (family: string) => (_style?: string, _opts?: unknown) => ({ fontFamily: family });
+export const loadSpaceGrotesk = make("Space Grotesk");
+export const loadPlayfair = make("Playfair Display");
